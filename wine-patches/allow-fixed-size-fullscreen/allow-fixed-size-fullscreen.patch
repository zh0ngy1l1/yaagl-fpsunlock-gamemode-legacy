@@ -2011,6 +2019,7 @@ - (void) setFrameFromWine:(NSRect)contentRect
                     NSEnableScreenUpdates();
 
                 if (!enteringFullScreen &&
+                    !(fixedSizeFullscreen && ([self styleMask] & NSWindowStyleMaskFullScreen || exitingFullScreen)) &&
                     [[NSProcessInfo processInfo] systemUptime] - enteredFullScreenTime > 1.0)
                     nonFullscreenFrame = frame;
 
@@ -3001,11 +3010,30 @@ - (void) windowDidEnterFullScreen:(NSNotification*)notification
             [self doOrderOut];
     }
 
+    - (void) restoreNonFullscreenChildFrames
+    {
+        /* AppKit may move attached owned windows while centering/restoring a
+         * nonresizable fullscreen window. Restore their windowed positions too.
+         * Weak keys allow windows destroyed during fullscreen to disappear.
+         */
+        for (WineWindow* child in nonFullscreenChildFrames)
+        {
+            if (child.parentWindow == self || child.latentParentWindow == self)
+            {
+                [child setFrameAndWineFrame:[[nonFullscreenChildFrames objectForKey:child] rectValue]];
+                [child windowDidResize:nil];
+            }
+        }
+        [nonFullscreenChildFrames release];
+        nonFullscreenChildFrames = nil;
+    }
+
     - (void) windowDidExitFullScreen:(NSNotification*)notification
     {
         exitingFullScreen = FALSE;
         [self setFrameAndWineFrame:nonFullscreenFrame];
         [self windowDidResize:nil];
+        [self restoreNonFullscreenChildFrames];
         if (pendingOrderOut)
             [self doOrderOut];
     }
@@ -3014,6 +3042,7 @@ - (void) windowDidFailToEnterFullScreen:(NSWindow*)window
     {
         enteringFullScreen = FALSE;
         enteredFullScreenTime = 0;
+        [self restoreNonFullscreenChildFrames];
         if (pendingOrderOut)
             [self doOrderOut];
     }
@@ -3142,6 +3171,15 @@ - (void) windowWillEnterFullScreen:(NSNotification*)notification
     {
         enteringFullScreen = TRUE;
         nonFullscreenFrame = self.wine_fractionalFrame;
+        if (fixedSizeFullscreen)
+        {
+            [nonFullscreenChildFrames release];
+            nonFullscreenChildFrames = [[NSMapTable weakToStrongObjectsMapTable] retain];
+            for (WineWindow* child in self.childWineWindows)
+                [nonFullscreenChildFrames setObject:[NSValue valueWithRect:child.wine_fractionalFrame] forKey:child];
+            for (WineWindow* child in latentChildWindows)
+                [nonFullscreenChildFrames setObject:[NSValue valueWithRect:child.wine_fractionalFrame] forKey:child];
+        }
     }
 
     - (void) windowWillExitFullScreen:(NSNotification*)notification
