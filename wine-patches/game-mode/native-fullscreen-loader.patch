+#ifdef __APPLE__
+/* The signed targets are installed together. Selection happens before ntdll
+ * initializes the Windows process, preserving argv and inherited server state. */
+static void select_game_bundle( char **argv )
+{
+    const char *enabled = getenv( "YAAGL_NATIVE_FULLSCREEN" );
+    const char *self;
+    char *dir, *parent, *target;
+
+    if (!enabled || strcmp( enabled, "1" )) return;
+    if (!(self = get_self_exe()) || !(dir = realpath_dirname( self )))
+    {
+        fprintf( stderr, "wine: cannot locate native fullscreen loader\n" );
+        exit(1);
+    }
+    free( (void *)self );
+    if ((parent = remove_tail( dir, "/WineGame.app/Contents/MacOS" )))
+    {
+        free( parent );
+        free( dir );
+        return;  /* Already executing the bundled target. */
+    }
+    target = build_path( dir, "WineGame.app/Contents/MacOS/wine" );
+    free( dir );
+    execv( target, argv );
+    fprintf( stderr, "wine: cannot exec native fullscreen loader %s: %s\n", target, strerror(errno) );
+    exit(1);
+}
+#endif
+

